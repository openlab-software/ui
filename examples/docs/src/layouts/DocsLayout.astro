---
import { defaultTheme, darkTheme } from "@openlab-ui/core/theme/default.css";
import { vars } from "@openlab-ui/core/theme/theme-contract.css";
import "@openlab-ui/react/styles.css";
import "@openlab-ui/vue/styles.css";
import "../styles/docs.css";
import "@fontsource/geist-mono";

interface Props {
  title: string;
  description?: string;
  activeId: string;
}

const { title, description, activeId } = Astro.props;

// Theme vars are hashed by vanilla-extract; expose them under plain names for docs.css.
const themeAliases = Object.entries({
  background: vars.color.background,
  foreground: vars.color.foreground,
  muted: vars.color.muted,
  "muted-foreground": vars.color.mutedForeground,
  primary: vars.color.primary,
  "primary-foreground": vars.color.primaryForeground,
  border: vars.color.border,
  ring: vars.color.ring,
})
  .map(([name, value]) => `--color-${name}:${value}`)
  .concat(`--font-body:${vars.font.body}`)
  .join(";");

const NAV = [
  {
    title: "Getting Started",
    items: [{ id: "overview", label: "Overview" }],
  },
  {
    title: "Layout",
    items: [
      { id: "card", label: "Card" },
      { id: "separator", label: "Separator" },
      { id: "scroll-area", label: "Scroll Area" },
    ],
  },
  {
    title: "Forms",
    items: [
      { id: "button", label: "Button" },
      { id: "field", label: "Field" },
      { id: "input", label: "Input & Textarea" },
      { id: "input-group", label: "Input Group" },
      { id: "number-field", label: "Number Field" },
      { id: "select", label: "Select" },
      { id: "combobox", label: "Combobox" },
      { id: "autocomplete", label: "Autocomplete" },
      { id: "checkbox", label: "Checkbox" },
      { id: "checkbox-group", label: "Checkbox Group" },
      { id: "radio-group", label: "Radio Group" },
      { id: "switch", label: "Switch" },
      { id: "slider", label: "Slider" },
    ],
  },
  {
    title: "Display",
    items: [
      { id: "badge", label: "Badge" },
      { id: "alert", label: "Alert" },
      { id: "avatar", label: "Avatar" },
      { id: "progress", label: "Progress & Meter" },
      { id: "table", label: "Table" },
      { id: "datatable", label: "Data Table" },
    ],
  },
  {
    title: "Feedback",
    items: [
      { id: "spinner", label: "Spinner & Skeleton" },
      { id: "toast", label: "Toast" },
    ],
  },
  {
    title: "Overlay",
    items: [
      { id: "dialog", label: "Dialog" },
      { id: "alert-dialog", label: "Alert Dialog" },
      { id: "drawer", label: "Drawer" },
      { id: "popover", label: "Popover" },
      { id: "preview-card", label: "Preview Card" },
      { id: "context-menu", label: "Context Menu" },
      { id: "tooltip", label: "Tooltip" },
      { id: "menu", label: "Menu" },
    ],
  },
  {
    title: "Navigation",
    items: [
      { id: "accordion", label: "Accordion" },
      { id: "collapsible", label: "Collapsible" },
      { id: "tabs", label: "Tabs" },
      { id: "toolbar", label: "Toolbar" },
    ],
  },
  {
    title: "Utilities",
    items: [{ id: "misc", label: "Kbd, Toggle, Breadcrumb…" }],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — OpenLab UI</title>
  </head>
  <body>
    <div
      id="theme-root"
      class={defaultTheme}
      style={themeAliases}
      data-default-class={defaultTheme}
      data-dark-class={darkTheme}
    >
      <script is:inline>
        // Apply the saved theme before first paint to avoid a light flash.
        try {
          if (localStorage.getItem("openlab-dark") === "true") {
            var el = document.getElementById("theme-root");
            el.classList.remove(el.dataset.defaultClass);
            el.classList.add(el.dataset.darkClass);
            document.body.classList.add(el.dataset.darkClass);
          }
        } catch (e) {}
      </script>
      <div class="docs-root">
        <header class="docs-header">
          <div class="docs-header-start">
            <button
              id="menu-toggle"
              class="docs-icon-btn docs-menu-btn"
              type="button"
              aria-label="Toggle navigation"
              aria-controls="docs-sidebar"
              aria-expanded="false"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
              >
            </button>
            <a href="/overview" class="docs-header-brand">
              <div class="docs-header-brand-logo">OL</div>
              <span>OpenLab UI</span>
            </a>
          </div>
          <div class="docs-header-actions">
            <button
              id="dark-toggle"
              class="docs-icon-btn"
              type="button"
              aria-label="Toggle dark mode"
            >
              <svg
                id="icon-moon"
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
              >
              <svg
                id="icon-sun"
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                style="display:none"
                ><circle cx="12" cy="12" r="4"></circle><path
                  d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path></svg
              >
            </button>
          </div>
        </header>

        <div class="docs-body">
          <nav class="docs-sidebar" id="docs-sidebar" aria-label="Components">
            {
              NAV.map((section) => (
                <div class="docs-nav-section">
                  <div class="docs-nav-section-title">{section.title}</div>
                  {section.items.map((item) => (
                    <a
                      href={`/${item.id}`}
                      class={`docs-nav-item${activeId === item.id ? " active" : ""}`}
                      aria-current={activeId === item.id ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              ))
            }
          </nav>
          <div class="docs-scrim" id="docs-scrim"></div>

          <main class="docs-main">
            <h1 class="docs-page-title">{title}</h1>
            {description && <p class="docs-page-description">{description}</p>}
            <slot />
          </main>
        </div>
      </div>
    </div>

    <script>
      const root = document.getElementById("theme-root")!;
      const defaultClass = root.dataset.defaultClass!;
      const darkClass = root.dataset.darkClass!;

      function applyTheme(dark: boolean) {
        if (dark) {
          root.classList.remove(defaultClass);
          root.classList.add(darkClass);
          document.body.classList.remove(defaultClass);
          document.body.classList.add(darkClass);
        } else {
          root.classList.remove(darkClass);
          root.classList.add(defaultClass);
          document.body.classList.remove(darkClass);
          document.body.classList.add(defaultClass);
        }
        const moonIcon = document.getElementById("icon-moon")!;
        const sunIcon = document.getElementById("icon-sun")!;
        moonIcon.style.display = dark ? "none" : "";
        sunIcon.style.display = dark ? "" : "none";
      }

      const savedDark = localStorage.getItem("openlab-dark") === "true";
      applyTheme(savedDark);

      document.getElementById("dark-toggle")!.addEventListener("click", () => {
        const isDark = root.classList.contains(darkClass);
        applyTheme(!isDark);
        localStorage.setItem("openlab-dark", String(!isDark));
      });

      let currentFw = localStorage.getItem("openlab-fw") || "react";

      function switchFw(fw: string) {
        currentFw = fw;
        localStorage.setItem("openlab-fw", fw);

        document.querySelectorAll<HTMLElement>(".fw-section-tab").forEach((tab) => {
          tab.classList.toggle("active", tab.dataset.fw === fw);
        });
        document.querySelectorAll<HTMLElement>(".fw-panel").forEach((panel) => {
          panel.hidden = panel.dataset.fw !== fw;
        });
      }

      function injectSectionTabs() {
        document.querySelectorAll<HTMLElement>(".docs-section").forEach((section) => {
          const reactPanel = section.querySelector<HTMLElement>('.fw-panel[data-fw="react"]');
          const vuePanel = section.querySelector<HTMLElement>('.fw-panel[data-fw="vue"]');
          if (!reactPanel || !vuePanel) return;

          const bar = document.createElement("div");
          bar.className = "fw-section-tabs";
          bar.setAttribute("role", "group");
          bar.setAttribute("aria-label", "Framework");

          (["react", "vue"] as const).forEach((fw) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "fw-section-tab";
            btn.dataset.fw = fw;
            btn.textContent = fw === "react" ? "React" : "Vue";
            btn.addEventListener("click", () => switchFw(fw));
            bar.appendChild(btn);
          });

          const label = document.createElement("span");
          label.className = "fw-switch-label";
          label.textContent = "Framework";
          const sw = document.createElement("div");
          sw.className = "fw-switch";
          sw.append(label, bar);

          const title = section.querySelector<HTMLElement>(".docs-section-title");
          if (title) {
            const head = document.createElement("div");
            head.className = "docs-section-head";
            title.replaceWith(head);
            head.append(title, sw);
          } else {
            section.insertBefore(sw, reactPanel);
          }
        });
      }

      // Label each pane so preview and code are unmistakable
      function labelPanes() {
        document.querySelectorAll<HTMLElement>(".fw-panel").forEach((panel) => {
          const preview = panel.querySelector<HTMLElement>(".docs-preview");
          if (preview) {
            const bar = document.createElement("div");
            bar.className = "docs-pane-bar";
            bar.innerHTML = '<span class="docs-pane-label">Preview</span>';
            preview.before(bar);
          }
          const header = panel.querySelector<HTMLElement>(".docs-code-header");
          const lang = header?.querySelector("span");
          if (header && lang) {
            const label = document.createElement("span");
            label.className = "docs-pane-label";
            label.textContent = "Code";
            lang.className = "docs-pane-lang";
            header.prepend(label);
          }
        });
      }

      injectSectionTabs();
      labelPanes();
      switchFw(currentFw);

      // Mobile navigation drawer
      const menuBtn = document.getElementById("menu-toggle")!;
      const docsRoot = document.querySelector<HTMLElement>(".docs-root")!;
      function setNav(open: boolean) {
        docsRoot.classList.toggle("docs-nav-open", open);
        menuBtn.setAttribute("aria-expanded", String(open));
      }
      menuBtn.addEventListener("click", () => setNav(!docsRoot.classList.contains("docs-nav-open")));
      document.getElementById("docs-scrim")!.addEventListener("click", () => setNav(false));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setNav(false);
      });

      // Keep the active nav item visible in the sidebar
      document.querySelector(".docs-nav-item.active")?.scrollIntoView({ block: "center" });

      // Copy buttons on code blocks
      document.querySelectorAll<HTMLElement>(".docs-code").forEach((block) => {
        const header = block.querySelector(".docs-code-header");
        const pre = block.querySelector("pre");
        if (!header || !pre) return;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "docs-copy-btn";
        btn.textContent = "Copy";
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(pre.textContent ?? "");
            btn.textContent = "Copied";
          } catch {
            btn.textContent = "Failed";
          }
          setTimeout(() => (btn.textContent = "Copy"), 1500);
        });
        header.appendChild(btn);
      });
    </script>
  </body>
</html>
